class Solution {
public:
   int search(vector<int>& nums, int target) {

    unordered_map<int, int> m;
    int k = -1;

    for (int i = 0; i < nums.size(); i++) {
        m[nums[i]] = i;
    }
    sort(nums.begin(), nums.end());

    int left = 0;
    int right = nums.size() - 1;
    int mid;
    while (left <= right) {
        mid = (right + left) / 2;
        if (nums[mid] < target) {
            left = mid + 1;
        } else if (nums[mid] > target) {
            right = mid - 1;
        } else {
            k = m[nums[mid]];
            break;
        }
    }

    return k;
}
};
