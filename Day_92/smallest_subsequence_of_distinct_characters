class Solution {
public:
    string smallestSubsequence(string s) {

        unordered_map<char, int> last;

        
        for (int i = 0; i < s.length(); i++) {
            last[s[i]] = i;
        }

        stack<char> st;
        unordered_set<char> inStack;

        for (int i = 0; i < s.length(); i++) {

            
            if (inStack.count(s[i]))
                continue;

            
            while (!st.empty() &&
                   st.top() > s[i] &&
                   last[st.top()] > i) {

                inStack.erase(st.top());
                st.pop();
            }

            st.push(s[i]);
            inStack.insert(s[i]);
        }

        string ans;

        while (!st.empty()) {
            ans.push_back(st.top());
            st.pop();
        }

        reverse(ans.begin(), ans.end());

        return ans;
    }
};
